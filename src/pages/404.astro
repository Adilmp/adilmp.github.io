---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.ts';
---

<Base title="Page not found | Adil Pervez" description="That page does not exist.">
  <div class="wrap empty-404">
    <p class="kicker"><span>Error 404</span></p>
    <h1>Wrong turn.</h1>
    <p class="sub">There is no page at this address. I would rather say so than guess what you were after.</p>
    <div class="cta-row" style="margin-top: 26px">
      <a class="btn" href={url('/')}>Back to the portfolio</a>
      <a class="btn btn-ghost" href={url('/#ask')}>Search it instead</a>
    </div>
  </div>
</Base>
