---
import { site } from '../data/site.ts';
import { projectColor } from '../lib/colors.ts';
import type { ProjectEntry } from '../lib/schema.ts';
import { url } from '../lib/url.ts';

interface Props {
  entries: ProjectEntry[];
}
const { entries } = Astro.props;

// Each finding points at a headline tile, so its number has the same receipt the case study shows.
// The sentence is split around the tile's value so the number can be set big.
const findings = site.heroFindings.flatMap((f) => {
  const i = entries.findIndex((x) => x.id === f.project);
  const e = entries[i];
  const tile = e?.data.headline[f.tile];
  if (!e || !tile) return [];
  const at = f.text.indexOf(tile.value);
  if (at < 0) return [];
  return [
    {
      id: e.id,
      title: e.data.title,
      color: projectColor(i),
      before: f.text.slice(0, at),
      value: tile.value,
      after: f.text.slice(at + tile.value.length),
    },
  ];
});
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="kicker"><span>{site.name}</span><span>{site.location}</span></p>
      <h1 class="headline">{site.pitch}</h1>
      <p class="subline">{site.subline}</p>
      {
        site.email && (
          <div class="cta-block">
            <a class="btn" href={`mailto:${site.email}`}>{site.ctaLabel}</a>
            <p class="cta-hint">{site.ctaHint}</p>
          </div>
        )
      }
    </div>

    <ul class="findings" aria-label="What I found">
      {
        findings.map((f) => (
          <li class="finding" data-c={f.color}>
            <a href={url(`/projects/${f.id}`)}>
              <p>
                {f.before}
                <b>{f.value}</b>
                {f.after}
              </p>
              <em>{f.title} ↗</em>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
